{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "checkJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "tooldock-types/ui"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
